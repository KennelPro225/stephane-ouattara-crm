# Copy to .env.docker and adjust:
#   cp .env.docker.example .env.docker

APP_NAME="Stéphane Ouattara"
APP_ENV=production
APP_DEBUG=false

# Leave empty and one is generated on first boot, then kept in /data/app_key on
# the database volume — it survives restarts and upgrades, and only disappears
# along with the data it encrypts. Set it explicitly to manage the key yourself
# (an explicit value always wins over the stored one).
APP_KEY=

# Must be the public URL clients actually reach: uploaded image URLs and every
# generated link are built from it.
APP_URL=https://stephane-ouattara.com

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

LOG_CHANNEL=stderr
LOG_LEVEL=warning

# SQLite lives on the crm-database volume mounted at /data.
DB_CONNECTION=sqlite
DB_DATABASE=/data/database.sqlite

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Cookies are only sent over HTTPS once you terminate TLS in front of the app.
SESSION_SECURE_COOKIE=true

CACHE_STORE=database
QUEUE_CONNECTION=database
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# Booking confirmations and admin alerts are queued notifications — set real
# SMTP credentials or they will only ever be written to the log.
MAIL_MAILER=smtp
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SCHEME=tls
MAIL_FROM_ADDRESS="contact@stephane-ouattara.com"
MAIL_FROM_NAME="${APP_NAME}"
